@startuml Condominium_Lottery_System
!define INTERFACE_COLOR #E6F3FF
!define MODEL_COLOR #F0F0F0
!define SERVICE_COLOR #E6F9E6
!define ENUM_COLOR #FFF9E6

skinparam classBackgroundColor MODEL_COLOR
skinparam classBorderColor #333333
skinparam classArrowColor #333333
skinparam classBackgroundColor<<interface>> INTERFACE_COLOR
skinparam classBackgroundColor<<service>> SERVICE_COLOR
skinparam classBackgroundColor<<enum>> ENUM_COLOR

' ==================== ENUMS ====================
enum UnitType <<enum>> {
  STUDIO
  ONE_BEDROOM
  TWO_BEDROOM
  THREE_BEDROOM
}

enum RegistrationStatus <<enum>> {
  PENDING
  APPROVED
  WON
  LOST
}

' ==================== EXCEPTIONS ====================
class RegistrationException <<exception>> {
  - {static} serialVersionUID: long
  --
  + RegistrationException(message: String)
  + RegistrationException(message: String, cause: Throwable)
}

' ==================== MODEL CLASSES ====================
class Person {
  - id: String
  - fullName: String
  - phone: String
  --
  + Person(id: String, fullName: String, phone: String)
  + getId(): String
  + setId(id: String): void
  + getFullName(): String
  + setFullName(fullName: String): void
  + getPhone(): String
  + setPhone(phone: String): void
  + displayInfo(): String
}

class Applicant {
  - email: String
  - address: String
  - registrationDate: String
  --
  + Applicant(id: String, fullName: String, phone: String, email: String, address: String, registrationDate: String)
  + getEmail(): String
  + setEmail(email: String): void
  + getAddress(): String
  + setAddress(address: String): void
  + getRegistrationDate(): String
  + setRegistrationDate(date: String): void
  + displayInfo(): String
  - padRight(s: String, n: int): String
}

class Admin {
  - role: String
  - department: String
  --
  + Admin(id: String, fullName: String, phone: String, role: String, department: String)
  + getRole(): String
  + setRole(role: String): void
  + getDepartment(): String
  + setDepartment(dept: String): void
  + displayInfo(): String
  - padRight(s: String, n: int): String
}

class Registration {
  - registrationId: String
  - applicantId: String
  - unitType: UnitType
  - registrationDate: String
  - status: RegistrationStatus
  --
  + Registration(registrationId: String, applicantId: String, unitType: UnitType, registrationDate: String, status: RegistrationStatus)
  + getRegistrationId(): String
  + setRegistrationId(registrationId: String): void
  + getApplicantId(): String
  + setApplicantId(applicantId: String): void
  + getUnitType(): UnitType
  + setUnitType(unitType: UnitType): void
  + getRegistrationDate(): String
  + setRegistrationDate(registrationDate: String): void
  + getStatus(): RegistrationStatus
  + setStatus(status: RegistrationStatus): void
  + displayInfo(): String
}

' ==================== SERVICE INTERFACE ====================
interface Manageable<<interface>> {
  + {abstract} add(item: T): void
  + {abstract} displayAll(): void
  + {abstract} searchById(id: String): T
  + {abstract} update(item: T): void
  + {abstract} delete(id: String): void
}

' ==================== SERVICES ====================
class ApplicantService <<service>> {
  - applicants: List<Applicant>
  - FILE_PATH: String
  --
  + ApplicantService()
  + add(applicant: Applicant): void
  + displayAll(): void
  + searchById(applicantId: String): Applicant
  + update(updatedApplicant: Applicant): void
  + delete(applicantId: String): void
  + getAll(): List<Applicant>
  - loadFromFile(): void
  - saveToFile(): void
}

class RegistrationService <<service>> {
  - registrations: List<Registration>
  - FILE_PATH: String
  --
  + RegistrationService()
  + add(registration: Registration): void
  + displayAll(): void
  + searchById(registrationId: String): Registration
  + update(updatedRegistration: Registration): void
  + delete(registrationId: String): void
  + getPendingRegistrationsByType(unitType: UnitType): List<Registration>
  + getAll(): List<Registration>
  - loadFromFile(): void
  - saveToFile(): void
}

' ==================== MAIN APPLICATION ====================
class Main {
  - {static} applicantService: ApplicantService
  - {static} registrationService: RegistrationService
  - {static} scanner: Scanner
  --
  + {static} main(args: String[]): void
  - {static} initializeServices(): void
  - {static} displayWelcome(): void
  - {static} displayMainMenu(): void
  - {static} readString(prompt: String): String
  - {static} readIntChoice(prompt: String, min: int, max: int): int
  - {static} readConfirmation(message: String): boolean
  - {static} manageApplicants(): void
  - {static} addApplicant(): void
  - {static} searchApplicant(): void
  - {static} updateApplicant(): void
  - {static} deleteApplicant(): void
  - {static} manageRegistrations(): void
  - {static} addRegistration(): void
  - {static} searchRegistration(): void
  - {static} updateRegistration(): void
  - {static} deleteRegistration(): void
  - {static} conductLotteryDraw(): void
  - {static} displayWinners(): void
  - {static} displaySystemDirectory(): void
  - {static} displaySystemStatistics(): void
}

' ==================== RELATIONSHIPS ====================

' Inheritance
Person <|-- Applicant : extends
Person <|-- Admin : extends

' Implementations
Manageable <|.. ApplicantService : implements
Manageable <|.. RegistrationService : implements

' Associations
Registration --> UnitType : uses
Registration --> RegistrationStatus : uses

' Service Usage
Main --> ApplicantService : uses
Main --> RegistrationService : uses

ApplicantService --> Applicant : manages
RegistrationService --> Registration : manages

' Exception Throws
Main ..> RegistrationException : throws
RegistrationService ..> RegistrationException : throws

' Exception Inheritance
Exception <|-- RegistrationException : extends

' Notes
note right of Person
  Base class providing base displayInfo()
  method overridden by subclasses
end note

note right of Manageable
  Generic interface defining standard
  operations for all services
end note

note right of Registration
  Links Applicant to UnitType
  Status: PENDING -> (WON|LOST)
end note

@enduml
